<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Invoice - <%= order.id %></title>
    <style>
        @import url('https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap');

        @page {
            size: A4;
            margin: 15mm;
        }

        * {
            box-sizing: border-box;
        }

        body {
            font-family: 'Inter', Arial, sans-serif;
            margin: 0;
            padding: 0;
            color: #374151;
            background: #FFFFFF;
            font-size: 11px;
            line-height: 1.5;
        }

        .invoice-container {
            width: 100%;
            max-width: 800px;
            margin: 0 auto;
        }

        .invoice-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 30px;
        }

        .company-info h1 {
            font-size: 36px;
            font-weight: 700;
            color: #2563EB;
            margin: 0 0 8px 0;
        }

        .company-info p {
            margin: 3px 0;
            font-size: 11px;
            color: #6B7280;
        }

        .invoice-meta {
            text-align: right;
        }

        .invoice-meta h2 {
            font-size: 28px;
            font-weight: 700;
            color: #111827;
            margin: 0 0 8px 0;
        }

        .invoice-meta .invoice-number {
            font-size: 16px;
            font-weight: 600;
            color: #2563EB;
            margin-bottom: 8px;
        }

        .invoice-meta p {
            margin: 4px 0;
            font-size: 11px;
            color: #6B7280;
        }

        .address-section {
            display: grid;
            grid-template-columns: 1fr 1fr 1fr;
            gap: 20px;
            margin-bottom: 30px;
        }

        .address-box {
            background: #F9FAFB;
            border-radius: 8px;
            padding: 16px;
        }

        .address-box h3 {
            font-size: 10px;
            color: #6B7280;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0 0 12px 0;
            font-weight: 700;
        }

        .address-box p {
            margin: 5px 0;
            font-size: 10px;
            color: #374151;
            line-height: 1.6;
        }

        .address-box .name {
            font-weight: 600;
            font-size: 11px;
            color: #111827;
            margin-bottom: 8px;
        }

        .payment-info {
            background: #EFF6FF;
            border-radius: 8px;
            padding: 16px;
            margin-bottom: 30px;
        }

        .payment-info h3 {
            font-size: 10px;
            color: #1E40AF;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0 0 12px 0;
            font-weight: 700;
        }

        .payment-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 16px;
        }

        .payment-item {
            display: flex;
            flex-direction: column;
        }

        .payment-label {
            font-size: 9px;
            color: #6B7280;
            text-transform: uppercase;
            letter-spacing: 0.3px;
            margin-bottom: 4px;
        }

        .payment-value {
            font-size: 11px;
            font-weight: 600;
            color: #111827;
        }

        .items-table {
            margin-bottom: 20px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        thead th {
            background: #F9FAFB;
            padding: 12px 10px;
            text-align: left;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: 0.4px;
            color: #6B7280;
            font-weight: 700;
            border-bottom: 2px solid #E5E7EB;
        }

        tbody td {
            padding: 14px 10px;
            border-bottom: 1px solid #F3F4F6;
            vertical-align: top;
        }

        tbody tr:last-child td {
            border-bottom: 2px solid #E5E7EB;
        }

        .product-name {
            font-weight: 600;
            color: #111827;
            margin-bottom: 4px;
            font-size: 11px;
        }

        .product-details {
            font-size: 9px;
            color: #9CA3AF;
            line-height: 1.4;
        }

        .quantity {
            text-align: center;
            font-weight: 600;
            color: #374151;
        }

        .price,
        .total {
            text-align: right;
            font-weight: 600;
            color: #111827;
        }

        .summary-section {
            margin-top: 20px;
            margin-left: auto;
            width: 300px;
        }

        .summary-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 10px 0;
            font-size: 11px;
            color: #6B7280;
        }

        .summary-row.total {
            margin-top: 10px;
            padding-top: 14px;
            border-top: 2px solid #E5E7EB;
            font-weight: 700;
            font-size: 15px;
            color: #111827;
        }

        .summary-row.total .amount {
            color: #2563EB;
            font-size: 18px;
        }

        .status-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .status-pending { background: #FEF3C7; color: #92400E; }
        .status-processing { background: #DBEAFE; color: #1E40AF; }
        .status-shipped { background: #E0E7FF; color: #3730A3; }
        .status-delivered { background: #D1FAE5; color: #065F46; }
        .status-cancelled { background: #FEE2E2; color: #991B1B; }

        .payment-badge {
            display: inline-block;
            padding: 5px 12px;
            border-radius: 6px;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .payment-pending { background: #FEF3C7; color: #92400E; }
        .payment-completed { background: #D1FAE5; color: #065F46; }
        .payment-failed { background: #FEE2E2; color: #991B1B; }

        .footer-note {
            margin-top: 30px;
            padding-top: 20px;
            border-top: 1px solid #E5E7EB;
            text-align: center;
            font-size: 9px;
            color: #9CA3AF;
            line-height: 1.6;
        }
    </style>
</head>
<body>
    <div class="invoice-container">
        <!-- Invoice Header -->
        <div class="invoice-header">
            <div class="company-info">
                <h1>SwiftMart</h1>
                <p>Quick Commerce Platform</p>
                <p>Email: support@swiftmart.com</p>
                <p>Phone: +91 1800-123-4567</p>
            </div>
            <div class="invoice-meta">
                <h2>INVOICE</h2>
                <div class="invoice-number">#<%= order.id %></div>
                <p>Date: <%= new Date(order.createdAt).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }) %></p>
                <p>
                    <span class="status-badge status-<%= order.statusClass || 'pending' %>">
                        <%= order.statusLabel || 'Pending' %>
                    </span>
                </p>
            </div>
        </div>

        <!-- Address Section -->
        <div class="address-section">
            <div class="address-box">
                <h3>Bill To</h3>
                <p class="name"><%= order.customer.name || 'N/A' %></p>
                <p><%= order.customer.email || 'N/A' %></p>
                <p><%= order.customer.phone || 'N/A' %></p>
            </div>

            <div class="address-box">
                <h3>Ship To</h3>
                <p class="name"><%= order.customer.name || 'N/A' %></p>
                <p><%= order.addressLine1 || 'N/A' %></p>
                <% if (order.addressLine2) { %>
                    <p><%= order.addressLine2 %></p>
                <% } %>
                <p><%= order.city || '' %><%= order.city && order.state ? ', ' : '' %><%= order.state || '' %></p>
                <p><%= order.country || '' %> - <%= order.pincode || '' %></p>
            </div>

            <div class="address-box">
                <h3>Sold By</h3>
                <% if (order.items && order.items.length > 0 && order.items[0].product.shop) { %>
                    <p class="name"><%= order.items[0].product.shop.name || 'SwiftMart Store' %></p>
                    <p><%= order.items[0].product.shop.description || 'Official Store' %></p>
                    <% if (order.items[0].product.shop.seller) { %>
                        <p>Contact: <%= order.items[0].product.shop.seller.email || 'N/A' %></p>
                    <% } %>
                <% } else { %>
                    <p class="name">SwiftMart Store</p>
                    <p>Official Store</p>
                <% } %>
            </div>
        </div>

        <!-- Payment Information -->
        <div class="payment-info">
            <h3>Payment Information</h3>
            <div class="payment-grid">
                <div class="payment-item">
                    <span class="payment-label">Payment Method</span>
                    <span class="payment-value"><%= order.paymentMethodLabel || 'N/A' %></span>
                </div>
                <div class="payment-item">
                    <span class="payment-label">Payment Status</span>
                    <span class="payment-value">
                        <% if (order.isPaid) { %>
                            <span class="payment-badge payment-completed">Paid</span>
                        <% } else { %>
                            <span class="payment-badge payment-pending">Pending</span>
                        <% } %>
                    </span>
                </div>
                <div class="payment-item">
                    <span class="payment-label">Transaction Date</span>
                    <span class="payment-value"><%= new Date(order.createdAt).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' }) %></span>
                </div>
            </div>
        </div>

        <!-- Items Table -->
        <div class="items-table">
            <table>
                <thead>
                    <tr>
                        <th style="width: 50%;">Product Details</th>
                        <th style="width: 12%; text-align: center;">Qty</th>
                        <th style="width: 19%; text-align: right;">Unit Price</th>
                        <th style="width: 19%; text-align: right;">Total</th>
                    </tr>
                </thead>
                <tbody>
                    <% order.items.forEach(item => { %>
                        <tr>
                            <td>
                                <div class="product-name"><%= item.product.name %></div>
                                <div class="product-details">
                                    <%= item.product.description ? item.product.description.substring(0, 80) + (item.product.description.length > 80 ? '...' : '') : 'No description available' %>
                                </div>
                            </td>
                            <td class="quantity"><%= item.quantity %></td>
                            <td class="price">₹<%= Number(item.unitPrice || 0).toFixed(2) %></td>
                            <td class="total">₹<%= Number(item.lineTotal || 0).toFixed(2) %></td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <!-- Summary Section -->
        <div class="summary-section">
            <div class="summary-row">
                <div>Subtotal (<%= order.totalItems %> items)</div>
                <div>₹<%= Number((order.totalAmountNumber ?? order.totalAmount ?? 0) - (order.deliveryCharge || 0)).toFixed(2) %></div>
            </div>
            <div class="summary-row">
                <div>Delivery Charge</div>
                <div>₹<%= Number(order.deliveryCharge || 0).toFixed(2) %></div>
            </div>
            <div class="summary-row">
                <div>Tax & Fees</div>
                <div>₹0.00</div>
            </div>
            <div class="summary-row total">
                <div>Total Amount</div>
                <div class="amount">₹<%= Number(order.totalAmountNumber ?? order.totalAmount ?? 0).toFixed(2) %></div>
            </div>
        </div>

        <!-- Footer Note -->
        <div class="footer-note">
            <p>Thank you for shopping with SwiftMart!</p>
            <p>For any queries, contact us at support@swiftmart.com</p>
        </div>
    </div>
</body>
</html>
